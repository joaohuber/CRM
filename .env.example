# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Pode ser a "anon key" ou a nova "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Usada pelos webhooks para gravar leads. NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo dos webhooks. Gere algo longo, ex.: openssl rand -hex 32
WEBHOOK_SECRET=

# Domínios do site que podem enviar formulário direto do navegador e usar o tracker.
# Separe por vírgula. Use * para liberar qualquer origem (não recomendado).
ALLOWED_ORIGINS=https://www.seusite.com.br,https://seusite.com.br

# URL pública do CRM (usada na tela de Configurações)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
